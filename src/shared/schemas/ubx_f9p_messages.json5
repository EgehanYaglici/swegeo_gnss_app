      },
      fields: [
        { name: "track_true_deg", type: "float", unit: "deg", note: "Track true" },
        { name: "track_mag_deg", type: "float", unit: "deg", note: "Track magnetic" },
        { name: "sog_knots", type: "float", unit: "kn", note: "Speed over ground (knots)" },
        { name: "sog_kmh", type: "float", unit: "km/h", note: "Speed over ground (km/h)" }
      ]
    }
  },

  NMEA_ZDA: {
    requires: null,
    label: "UTC Time and Date",
    description: "UTC date/time sentence.",
    nmea: {
      tag: "ZDA",
